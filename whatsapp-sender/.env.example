# Required: password for the web UI (HTTP Basic auth)
# Optional APP_USER: if set, the login username must match it; if empty any username works.
APP_USER=
APP_PASSWORD=change-me
PORT=3000
HOST=127.0.0.1

# Sent credentials (from the Sent dashboard)
SENT_API_KEY=
SENT_SENDER_ID=
SENT_BASE_URL=https://api.sent.dm

# true = log what would be sent, never call Sent. Set to false to really send.
DRY_RUN=true
# Delay between messages in ms
SEND_DELAY_MS=1000
