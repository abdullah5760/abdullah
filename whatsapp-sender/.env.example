# Required: password for the web UI (HTTP Basic auth)
# Optional APP_USER: if set, the login username must match it; if empty any username works.
APP_USER=
APP_PASSWORD=change-me
PORT=3000
HOST=127.0.0.1

# Provider: meta (official WhatsApp Cloud API, default) or sent
PROVIDER=meta

# Meta WhatsApp Cloud API: permanent system-user token + the business phone number ID (Meta App Dashboard > API Setup)
META_TOKEN=
META_PHONE_NUMBER_ID=

# Sent credentials (only if PROVIDER=sent)
SENT_API_KEY=
SENT_SENDER_ID=
SENT_BASE_URL=https://api.sent.dm

# true = log what would be sent, never call Sent. Set to false to really send.
DRY_RUN=true
# Delay between messages in ms
SEND_DELAY_MS=1000

# Manual (wa.me) mode safety limits - conservative suggestions, NOT official WhatsApp numbers
DAILY_LIMIT=40
COOLDOWN_SEC=20
REPEAT_DAYS=7
